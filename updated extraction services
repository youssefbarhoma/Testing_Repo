package com.example.T4.application.evaluation.service;

import com.example.T4.application.evaluation.dto.ScoreResultDTO;
import com.example.T4.application.evaluation.mapper.ScoreMapper;
import com.example.T4.application.evaluation.model.JobExtractionResult;
import com.example.T4.application.evaluation.model.ScoreResult;
import com.example.T4.application.evaluation.repository.ScoreRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;
import java.util.Optional;

@Service
@RequiredArgsConstructor
@Transactional
public class ScoreServiceImpl implements ScoreService {

    private final ScoreRepository scoreRepository;
    private final ScoreMapper scoreMapper;
    private final ScoringEngine scoringEngine;

    @Override
    @Transactional(readOnly = true)
    public Optional<ScoreResultDTO> findByJobAndCandidate(String jobOpeningId, String candidateId) {
        return scoreRepository.findByJobOpeningIdAndCandidateId(jobOpeningId, candidateId)
                .map(scoreMapper::toDto);
    }

    @Override
    @Transactional(readOnly = true)
    public List<ScoreResultDTO> getRankedCandidatesForJob(String jobOpeningId) {
        return scoreRepository.findByJobOpeningIdOrderByScoreDesc(jobOpeningId).stream()
                .map(scoreMapper::toDto)
                .toList();
    }

    @Override
    public ScoreResultDTO computeAndSave(String jobOpeningId, JobRequirementsView requirements, JobExtractionResult extraction) {
        ScoreResult computed = scoringEngine.score(jobOpeningId, requirements, extraction);
        ScoreResult saved = scoreRepository.save(computed);
        return scoreMapper.toDto(saved);
    }
}



package com.example.T4.application.evaluation.service;

import com.example.T4.application.evaluation.builder.ScoreResultBuilder;
import com.example.T4.application.evaluation.model.JobExtractionResult;
import com.example.T4.application.evaluation.model.ScoreResult;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.Set;
import java.util.stream.Collectors;

/**
 * Pure matching logic: takes what a job requires and what a candidate has,
 * and produces a ScoreResult. Deliberately has no repository dependency -
 * it's a calculator, not a persistence-aware service. ScoreService is what
 * calls this and saves the result.
 */
@Component
public class ScoringEngine {

    private static final double MANDATORY_SKILL_WEIGHT = 10.0;
    private static final double PREFERRED_SKILL_WEIGHT = 4.0;
    private static final double EXPERIENCE_WEIGHT = 20.0;

    public ScoreResult score(String jobOpeningId, JobRequirementsView requirements, JobExtractionResult extraction) {
        ScoreResultBuilder builder = ScoreResultBuilder.forJobAndCandidate(jobOpeningId, extraction.getCandidateId());

        Set<String> candidateSkills = normalize(extraction.getSkills());

        scoreSkillGroup(builder, "MANDATORY_SKILL", requirements.getMandatorySkills(), candidateSkills, MANDATORY_SKILL_WEIGHT);
        scoreSkillGroup(builder, "PREFERRED_SKILL", requirements.getPreferredSkills(), candidateSkills, PREFERRED_SKILL_WEIGHT);
        scoreExperience(builder, requirements, extraction);

        builder.withExperienceYears(
                extraction.getTotalYearsExperience(),
                extraction.getRelevantYearsExperience()
        );

        return builder.build();
    }

    private void scoreSkillGroup(ScoreResultBuilder builder, String type, List<String> required,
                                  Set<String> candidateSkills, double weight) {
        if (required == null) {
            return;
        }
        for (String requiredSkill : required) {
            if (candidateSkills.contains(requiredSkill.trim().toLowerCase())) {
                builder.addMatch(type, requiredSkill, weight);
            } else {
                builder.addMissing(type, requiredSkill, weight);
            }
        }
    }

    private void scoreExperience(ScoreResultBuilder builder, JobRequirementsView requirements, JobExtractionResult extraction) {
        int relevantYears = extraction.getRelevantYearsExperience() == null ? 0 : extraction.getRelevantYearsExperience();
        if (relevantYears >= requirements.getMinExperienceYears()) {
            builder.addMatch("MIN_EXPERIENCE", relevantYears + " years", EXPERIENCE_WEIGHT);
        } else {
            builder.addMissing("MIN_EXPERIENCE",
                    "requires " + requirements.getMinExperienceYears() + " years, candidate has " + relevantYears,
                    EXPERIENCE_WEIGHT);
        }
    }

    private Set<String> normalize(List<String> skills) {
        if (skills == null) {
            return Set.of();
        }
        return skills.stream()
                .filter(s -> s != null && !s.isBlank())
                .map(s -> s.trim().toLowerCase())
                .collect(Collectors.toSet());
    }
}
