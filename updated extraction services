package com.example.T4.application.evaluation.service;

import com.example.T4.application.evaluation.dto.CandidateResponseDTO;

public interface CandidateService {

    CandidateResponseDTO getById(String id);

    CandidateResponseDTO getByCvDocumentId(String cvDocumentId);

    CandidateResponseDTO create(CandidateResponseDTO dto);
}
package com.example.T4.application.evaluation.service;

import com.example.T4.application.common.exception.ResourceNotFoundException;
import com.example.T4.application.evaluation.dto.CandidateResponseDTO;
import com.example.T4.application.evaluation.mapper.CandidateMapper;
import com.example.T4.application.evaluation.model.Candidate;
import com.example.T4.application.evaluation.repository.CandidateRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.UUID;

@Service
@RequiredArgsConstructor
@Transactional
public class CandidateServiceImpl implements CandidateService {

    private final CandidateRepository candidateRepository;
    private final CandidateMapper candidateMapper;

    @Override
    @Transactional(readOnly = true)
    public CandidateResponseDTO getById(String id) {
        Candidate candidate = candidateRepository.findById(id)
                .orElseThrow(() -> ResourceNotFoundException.of("Candidate", id));
        return candidateMapper.toDto(candidate);
    }

    @Override
    @Transactional(readOnly = true)
    public CandidateResponseDTO getByCvDocumentId(String cvDocumentId) {
        Candidate candidate = candidateRepository.findByCvDocumentId(cvDocumentId)
                .orElseThrow(() -> ResourceNotFoundException.of("Candidate for cv_document", cvDocumentId));
        return candidateMapper.toDto(candidate);
    }

    @Override
    public CandidateResponseDTO create(CandidateResponseDTO dto) {
        Candidate candidate = candidateMapper.toEntity(dto);
        if (candidate.getId() == null) {
            candidate.setId(UUID.randomUUID().toString());
        }
        Candidate saved = candidateRepository.save(candidate);
        return candidateMapper.toDto(saved);
    }
}


package com.example.T4.application.evaluation.service;

import com.example.T4.application.evaluation.builder.CandidateProfileBuilder;
import com.example.T4.application.evaluation.dto.CandidateProfileDTO;
import com.example.T4.application.evaluation.dto.CandidateResponseDTO;
import com.example.T4.application.evaluation.dto.ExtractionResultDTO;
import com.example.T4.application.evaluation.dto.ScoreResultDTO;
import com.example.T4.application.evaluation.mapper.ExtractionMapper;
import com.example.T4.application.evaluation.model.JobExtractionResult;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

/**
 * The one place that knows the pipeline order: extract -> score -> assemble profile.
 * Without this, the "extract then score" sequencing would live implicitly
 * scattered across a controller or a batch job, which is exactly the kind
 * of thing that gets duplicated and drifts out of sync.
 */
@Service
@RequiredArgsConstructor
public class EvaluationOrchestrator {

    private final CandidateService candidateService;
    private final ExtractionService extractionService;
    private final ScoreService scoreService;
    private final ExtractionMapper extractionMapper;

    /**
     * Called after a CV has been parsed by the AI pipeline (from the processing module).
     * Persists the extraction, scores it against the job's requirements, and returns
     * the finished profile in one shot.
     */
    public CandidateProfileDTO runEvaluation(String jobOpeningId, JobExtractionResult rawExtraction,
                                              JobRequirementsView requirements) {
        ExtractionResultDTO savedExtraction = extractionService.save(rawExtraction);

        JobExtractionResult persistedEntity = extractionMapper.toEntity(savedExtraction);
        ScoreResultDTO scoreResult = scoreService.computeAndSave(jobOpeningId, requirements, persistedEntity);

        CandidateResponseDTO candidate = candidateService.getById(rawExtraction.getCandidateId());

        return CandidateProfileBuilder.forCandidate(candidate)
                .withExtraction(savedExtraction)
                .withScore(scoreResult)
                .build();
    }

    /**
     * Read-only assembly for viewing an already-evaluated candidate
     * (e.g. opening a shortlist entry) - no computation, just composition.
     */
    public CandidateProfileDTO getProfile(String jobOpeningId, String candidateId) {
        CandidateResponseDTO candidate = candidateService.getById(candidateId);

        ExtractionResultDTO extraction = extractionService
                .findByJobAndCandidate(jobOpeningId, candidateId)
                .orElse(null);

        ScoreResultDTO score = scoreService
                .findByJobAndCandidate(jobOpeningId, candidateId)
                .orElse(null);

        return CandidateProfileBuilder.forCandidate(candidate)
                .withExtraction(extraction)
                .withScore(score)
                .build();
    }
}


