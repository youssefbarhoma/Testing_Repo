package com.yourcompany.ats.job.dto;

import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Getter;
import lombok.NoArgsConstructor;

import java.time.LocalDateTime;
import java.util.List;

/**
 * Page 2 of the wizard: the recruiter adds the attributes they care about
 * (skills, certifications, experience, education...) each with a weight.
 * The UI renders one row per WeightedItemDTO with a "weight" slider/input
 * next to it. minExperienceYears/educationLevel are single values, each
 * with its own weight, since they aren't lists.
 */
@Getter
@Builder
@NoArgsConstructor
@AllArgsConstructor
public class JobRequirementDTO {

    private String id;
    private String jobOpeningId;

    private List<WeightedItemDTO> mandatorySkills;
    private List<WeightedItemDTO> preferredSkills;
    private List<WeightedItemDTO> certifications;

    private Integer minExperienceYears;
    private Double experienceWeight;

    private String educationLevel;
    private Double educationWeight;

    private String location;          // filter/info only, not weighted
    private List<String> languages;   // filter/info only, not weighted

    private LocalDateTime confirmedAt;
}





package com.yourcompany.ats.common.converter;

import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import jakarta.persistence.AttributeConverter;
import jakarta.persistence.Converter;

import java.util.Collections;
import java.util.Map;

/**
 * Converts the job_requirements.weights JSONB column (attribute name -> weight)
 * into a Map<String, Double> and back. e.g. {"skill:java": 10.0, "min_experience": 20.0}
 */
@Converter
public class WeightsJsonConverter implements AttributeConverter<Map<String, Double>, String> {

    private static final ObjectMapper MAPPER = new ObjectMapper();

    @Override
    public String convertToDatabaseColumn(Map<String, Double> attribute) {
        if (attribute == null) {
            return null;
        }
        try {
            return MAPPER.writeValueAsString(attribute);
        } catch (Exception e) {
            throw new IllegalArgumentException("Unable to serialize weights to JSONB", e);
        }
    }

    @Override
    public Map<String, Double> convertToEntityAttribute(String dbData) {
        if (dbData == null || dbData.isBlank()) {
            return Collections.emptyMap();
        }
        try {
            return MAPPER.readValue(dbData, new TypeReference<Map<String, Double>>() {});
        } catch (Exception e) {
            throw new IllegalArgumentException("Unable to deserialize JSONB to weights map", e);
        }
    }
}

