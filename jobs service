    JobRequirementsView getRequirementsView(String jobOpeningId);
}



package com.yourcompany.ats.job.service;

import com.yourcompany.ats.common.exception.ResourceNotFoundException;
import com.yourcompany.ats.evaluation.service.JobRequirementsView;
import com.yourcompany.ats.job.builder.JobRequirementBuilder;
import com.yourcompany.ats.job.dto.JobRequirementDTO;
import com.yourcompany.ats.job.mapper.JobRequirementMapper;
import com.yourcompany.ats.job.model.JobOpening;
import com.yourcompany.ats.job.model.JobRequirement;
import com.yourcompany.ats.job.model.JobStatus;
import com.yourcompany.ats.job.repository.JobOpeningRepository;
import com.yourcompany.ats.job.repository.JobRequirementRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
@RequiredArgsConstructor
@Transactional
public class JobRequirementServiceImpl implements JobRequirementService {

    private final JobRequirementRepository jobRequirementRepository;
    private final JobOpeningRepository jobOpeningRepository;
    private final JobRequirementMapper jobRequirementMapper;

    @Override
    public JobRequirementDTO create(String jobOpeningId, JobRequirementDTO dto) {
        assertJobOpeningExists(jobOpeningId);
        if (jobRequirementRepository.existsByJobOpeningId(jobOpeningId)) {
            throw new IllegalStateException("Requirements already exist for job opening " + jobOpeningId
                    + " - use update instead");
        }

        JobRequirement requirement = fromWizardRows(jobOpeningId, dto);
        JobRequirement saved = jobRequirementRepository.save(requirement);
        return jobRequirementMapper.toDto(saved);
    }

    @Override
    public JobRequirementDTO update(String jobOpeningId, JobRequirementDTO dto) {
        JobRequirement existing = jobRequirementRepository.findByJobOpeningId(jobOpeningId)
                .orElseThrow(() -> ResourceNotFoundException.of("JobRequirement for job", jobOpeningId));

        JobRequirement rebuilt = fromWizardRows(jobOpeningId, dto);
        rebuilt.setId(existing.getId()); // keep the same row, replace its contents
        rebuilt.setConfirmedAt(existing.getConfirmedAt()); // editing does not silently re-confirm

        JobRequirement saved = jobRequirementRepository.save(rebuilt);
        return jobRequirementMapper.toDto(saved);
    }

    @Override
    public void delete(String jobOpeningId) {
        if (!jobRequirementRepository.existsByJobOpeningId(jobOpeningId)) {
            throw ResourceNotFoundException.of("JobRequirement for job", jobOpeningId);
        }
        jobRequirementRepository.deleteByJobOpeningId(jobOpeningId);
    }

    @Override
    @Transactional(readOnly = true)
    public JobRequirementDTO getByJobOpeningId(String jobOpeningId) {
        JobRequirement requirement = jobRequirementRepository.findByJobOpeningId(jobOpeningId)
                .orElseThrow(() -> ResourceNotFoundException.of("JobRequirement for job", jobOpeningId));
        return jobRequirementMapper.toDto(requirement);
    }

    @Override
    public JobRequirementDTO confirm(String jobOpeningId) {
        JobRequirement requirement = jobRequirementRepository.findByJobOpeningId(jobOpeningId)
                .orElseThrow(() -> ResourceNotFoundException.of("JobRequirement for job", jobOpeningId));

        JobRequirement confirmed = JobRequirementBuilder.confirm(requirement);
        JobRequirement saved = jobRequirementRepository.save(confirmed);

        JobOpening jobOpening = jobOpeningRepository.findById(jobOpeningId)
                .orElseThrow(() -> ResourceNotFoundException.of("JobOpening", jobOpeningId));
        jobOpening.setStatus(JobStatus.READY);
        jobOpeningRepository.save(jobOpening);

        return jobRequirementMapper.toDto(saved);
    }

    @Override
    @Transactional(readOnly = true)
    public JobRequirementsView getRequirementsView(String jobOpeningId) {
        JobRequirement requirement = jobRequirementRepository.findByJobOpeningId(jobOpeningId)
                .orElseThrow(() -> ResourceNotFoundException.of("JobRequirement for job", jobOpeningId));
        return JobRequirementBuilder.toRequirementsView(requirement);
    }

    private void assertJobOpeningExists(String jobOpeningId) {
        if (!jobOpeningRepository.existsById(jobOpeningId)) {
            throw ResourceNotFoundException.of("JobOpening", jobOpeningId);
        }
    }

    /**
     * Replays the DTO's weighted rows through the builder rather than
     * jobRequirementMapper.toEntity(dto) directly, so create/update always
     * go through the same one-row-at-a-time construction path as the wizard -
     * keeps the weights-map key convention centralized in one place.
     */
    private JobRequirement fromWizardRows(String jobOpeningId, JobRequirementDTO dto) {
        JobRequirementBuilder builder = JobRequirementBuilder.forJob(jobOpeningId);

        if (dto.getMandatorySkills() != null) {
            dto.getMandatorySkills().forEach(item ->
                    builder.addMandatorySkill(item.getName(), weightOrZero(item.getWeight())));
        }
        if (dto.getPreferredSkills() != null) {
            dto.getPreferredSkills().forEach(item ->
                    builder.addPreferredSkill(item.getName(), weightOrZero(item.getWeight())));
        }
        if (dto.getCertifications() != null) {
            dto.getCertifications().forEach(item ->
                    builder.addCertification(item.getName(), weightOrZero(item.getWeight())));
        }
        if (dto.getMinExperienceYears() != null) {
            builder.withExperience(dto.getMinExperienceYears(), weightOrZero(dto.getExperienceWeight()));
        }
        if (dto.getEducationLevel() != null) {
            builder.withEducation(dto.getEducationLevel(), weightOrZero(dto.getEducationWeight()));
        }
        builder.withLocation(dto.getLocation());
        builder.withLanguages(dto.getLanguages());

        return builder.build();
    }

    private double weightOrZero(Double weight) {
        return weight == null ? 0.0 : weight;
    }
}
