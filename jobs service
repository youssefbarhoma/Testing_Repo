package com.yourcompany.ats.job.service;

import com.yourcompany.ats.common.exception.ResourceNotFoundException;
import com.yourcompany.ats.job.dto.JobOpeningRequestDTO;
import com.yourcompany.ats.job.dto.JobOpeningResponseDTO;
import com.yourcompany.ats.job.mapper.JobOpeningMapper;
import com.yourcompany.ats.job.model.JobOpening;
import com.yourcompany.ats.job.model.JobStatus;
import com.yourcompany.ats.job.repository.JobOpeningRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;
import java.util.UUID;

@Service
@RequiredArgsConstructor
@Transactional
public class JobOpeningServiceImpl implements JobOpeningService {

    private final JobOpeningRepository jobOpeningRepository;
    private final JobOpeningMapper jobOpeningMapper;

    @Override
    public JobOpeningResponseDTO create(JobOpeningRequestDTO dto) {
        JobOpening jobOpening = JobOpening.builder()
                .id(UUID.randomUUID().toString())
                .title(dto.getTitle())
                .jdText(dto.getJdText())
                .status(JobStatus.DRAFT) // page 1 saved -> DRAFT, requirements come next
                .createdBy(dto.getCreatedBy())
                .createdAt(LocalDateTime.now())
                .build();

        JobOpening saved = jobOpeningRepository.save(jobOpening);
        return jobOpeningMapper.toDto(saved);
    }

    @Override
    public JobOpeningResponseDTO update(String id, JobOpeningRequestDTO dto) {
        JobOpening existing = jobOpeningRepository.findById(id)
                .orElseThrow(() -> ResourceNotFoundException.of("JobOpening", id));

        existing.setTitle(dto.getTitle());
        existing.setJdText(dto.getJdText());
        // createdBy/createdAt/status are not touched by a plain edit of title+description

        JobOpening saved = jobOpeningRepository.save(existing);
        return jobOpeningMapper.toDto(saved);
    }

    @Override
    public void delete(String id) {
        if (!jobOpeningRepository.existsById(id)) {
            throw ResourceNotFoundException.of("JobOpening", id);
        }
        // job_requirements, cv_batches, shortlists etc. cascade via FK ON DELETE CASCADE
        jobOpeningRepository.deleteById(id);
    }

    @Override
    @Transactional(readOnly = true)
    public JobOpeningResponseDTO getById(String id) {
        JobOpening jobOpening = jobOpeningRepository.findById(id)
                .orElseThrow(() -> ResourceNotFoundException.of("JobOpening", id));
        return jobOpeningMapper.toDto(jobOpening);
    }

    @Override
    @Transactional(readOnly = true)
    public List<JobOpeningResponseDTO> listAll() {
        return jobOpeningRepository.findAll().stream()
                .map(jobOpeningMapper::toDto)
                .toList();
    }

    @Override
    @Transactional(readOnly = true)
    public List<JobOpeningResponseDTO> listByStatus(JobStatus status) {
        return jobOpeningRepository.findByStatus(status).stream()
                .map(jobOpeningMapper::toDto)
                .toList();
    }

    @Override
    public JobOpeningResponseDTO updateStatus(String id, JobStatus status) {
        JobOpening jobOpening = jobOpeningRepository.findById(id)
                .orElseThrow(() -> ResourceNotFoundException.of("JobOpening", id));
        jobOpening.setStatus(status);
        return jobOpeningMapper.toDto(jobOpeningRepository.save(jobOpening));
    }
}

package com.yourcompany.ats.job.service;

import com.yourcompany.ats.evaluation.service.JobRequirementsView;
import com.yourcompany.ats.job.dto.JobRequirementDTO;

public interface JobRequirementService {

    JobRequirementDTO create(String jobOpeningId, JobRequirementDTO dto);

    JobRequirementDTO update(String jobOpeningId, JobRequirementDTO dto);

    void delete(String jobOpeningId);

    JobRequirementDTO getByJobOpeningId(String jobOpeningId);

    // Locks in the requirements, stamps confirmed_at, flips the job to READY
    JobRequirementDTO confirm(String jobOpeningId);

