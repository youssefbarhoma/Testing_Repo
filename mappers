package com.yourcompany.ats.evaluation.mapper;

import com.yourcompany.ats.evaluation.dto.CandidateResponseDTO;
import com.yourcompany.ats.evaluation.model.Candidate;
import org.springframework.stereotype.Component;

@Component
public class CandidateMapper {

    public CandidateResponseDTO toDto(Candidate entity) {
        if (entity == null) {
            return null;
        }
        return CandidateResponseDTO.builder()
                .id(entity.getId())
                .cvDocumentId(entity.getCvDocumentId())
                .fullName(entity.getFullName())
                .email(entity.getEmail())
                .phoneNumber(entity.getPhoneNumber())
                .age(entity.getAge())
                .build();
    }

    public Candidate toEntity(CandidateResponseDTO dto) {
        if (dto == null) {
            return null;
        }
        return Candidate.builder()
                .id(dto.getId())
                .cvDocumentId(dto.getCvDocumentId())
                .fullName(dto.getFullName())
                .email(dto.getEmail())
                .phoneNumber(dto.getPhoneNumber())
                .age(dto.getAge())
                .build();
    }
}





